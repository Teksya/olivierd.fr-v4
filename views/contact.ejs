<%- include('partials/header') %>

<div class="page-wrap">

  <div class="about-header reveal">
    <p class="section-label">Contact</p>
    <h1>Me contacter</h1>
    <p>Vous avez un projet ou une opportunité ? Je suis disponible.</p>
  </div>

  <div class="divider"></div>

  <div class="contact-layout">

    <div class="reveal" style="transition-delay:.06s">
      <p class="contact-info-title">Coordonnées</p>

      <a href="mailto:olivierdutoit@etik.com" class="cinfo-row">
        <div class="cinfo-icon"><i class="fas fa-envelope"></i></div>
        <div>
          <div class="cinfo-label">Email</div>
          <div class="cinfo-val">olivierdutoit@etik.com</div>
        </div>
      </a>

      <a href="http://github.com/Teksya" target="_blank" rel="noopener" class="cinfo-row">
        <div class="cinfo-icon"><i class="fab fa-github"></i></div>
        <div>
          <div class="cinfo-label">GitHub</div>
          <div class="cinfo-val">Teksya</div>
        </div>
      </a>

      <a href="https://fr.linkedin.com/in/olivier-dutoit" target="_blank" rel="noopener" class="cinfo-row">
        <div class="cinfo-icon"><i class="fab fa-linkedin"></i></div>
        <div>
          <div class="cinfo-label">LinkedIn</div>
          <div class="cinfo-val">olivier-dutoit</div>
        </div>
      </a>

      <div class="cinfo-row" style="cursor:default">
        <div class="cinfo-icon"><i class="fas fa-map-marker-alt"></i></div>
        <div>
          <div class="cinfo-label">Localisation</div>
          <div class="cinfo-val">Saint-Étienne, France</div>
        </div>
      </div>
    </div>

    <div class="contact-form-wrap reveal" style="transition-delay:.1s">
      <p class="contact-info-title">Envoyer un message</p>

      <% if (success) { %>
        <div class="form-alert form-alert--success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="form-alert form-alert--error"><%= error %></div>
      <% } %>

      <form action="/contact" method="POST" style="display:flex;flex-direction:column;gap:1rem">
        <div class="form-grid-2">
          <div class="form-field">
            <label class="form-label" for="name">Nom</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="Jean Dupont" required>
          </div>
          <div class="form-field">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="jean@example.com" required>
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="subject">Sujet</label>
          <input class="form-input" type="text" id="subject" name="subject" placeholder="Demande de dev web">
        </div>
        <div class="form-field">
          <label class="form-label" for="message">Message</label>
          <textarea class="form-textarea" id="message" name="message" placeholder="Bonjour Olivier, ..." required></textarea>
        </div>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
        <div>
          <button class="btn btn-primary" type="submit">Envoyer</button>
        </div>
      </form>
    </div>

  </div>

</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<%- include('partials/footer') %>
