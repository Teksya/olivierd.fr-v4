<%- include('partials/header') %>

<div class="page-wrap">

  <div class="about-header reveal">
    <p class="section-label">Contact</p>
    <h1>Me contacter</h1>
    <p>Vous avez un projet ou une opportunité ? Je suis disponible.</p>
  </div>

  <div class="divider"></div>

  <div class="contact-layout">

    <div class="reveal" style="transition-delay:.06s">
      <p class="contact-info-title">Coordonnées</p>

      <a href="mailto:olivierdutoit@etik.com" class="cinfo-row">
        <div class="cinfo-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>
        <div>
          <div class="cinfo-label">Email</div>
          <div class="cinfo-val">olivierdutoit@etik.com</div>
        </div>
      </a>

      <a href="http://github.com/Teksya" target="_blank" rel="noopener" class="cinfo-row">
        <div class="cinfo-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg></div>
        <div>
          <div class="cinfo-label">GitHub</div>
          <div class="cinfo-val">Teksya</div>
        </div>
      </a>

      <a href="https://fr.linkedin.com/in/olivier-dutoit" target="_blank" rel="noopener" class="cinfo-row">
        <div class="cinfo-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg></div>
        <div>
          <div class="cinfo-label">LinkedIn</div>
          <div class="cinfo-val">olivier-dutoit</div>
        </div>
      </a>

      <div class="cinfo-row" style="cursor:default">
        <div class="cinfo-icon"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
        <div>
          <div class="cinfo-label">Localisation</div>
          <div class="cinfo-val">Saint-Étienne, France</div>
        </div>
      </div>
    </div>

    <div class="contact-form-wrap reveal" style="transition-delay:.1s">
      <p class="contact-info-title">Envoyer un message</p>

      <% if (success) { %>
        <div class="form-alert form-alert--success"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="form-alert form-alert--error"><%= error %></div>
      <% } %>

      <form action="/contact" method="POST" style="display:flex;flex-direction:column;gap:1rem">
        <div class="form-grid-2">
          <div class="form-field">
            <label class="form-label" for="name">Nom</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="Jean Dupont" required>
          </div>
          <div class="form-field">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="jean@example.com" required>
          </div>
        </div>
        <div class="form-field">
          <label class="form-label" for="subject">Sujet</label>
          <input class="form-input" type="text" id="subject" name="subject" placeholder="Demande de dev web">
        </div>
        <div class="form-field">
          <label class="form-label" for="message">Message</label>
          <textarea class="form-textarea" id="message" name="message" placeholder="Bonjour Olivier, ..." required></textarea>
        </div>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
        <div>
          <button class="btn btn-primary" type="submit">Envoyer</button>
        </div>
      </form>
    </div>

  </div>

</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<%- include('partials/footer') %>
