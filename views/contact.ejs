<%- include('partials/header') %>

<div class="mx-auto max-w-content px-6 py-20 sm:py-24">

  <section class="reveal">
    <p class="text-sm font-semibold text-accenth">Contact</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-strong sm:text-5xl">Me contacter</h1>
    <p class="mt-4 max-w-2xl text-base text-body">Vous avez un projet ou une opportunité ? Je suis disponible.</p>
  </section>

  <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.4fr]">

    <!-- COORDONNÉES -->
    <div class="reveal" style="transition-delay:.06s">
      <p class="text-sm font-semibold text-accenth">Coordonnées</p>
      <div class="mt-5 space-y-2">
        <a href="mailto:olivierdutoit@etik.com" class="flex items-center gap-4 rounded-xl border border-line bg-surface p-4 transition-colors hover:border-line2">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-surface2 text-body"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></span>
          <span><span class="block text-xs text-muted">Email</span><span class="block text-sm text-strong">olivierdutoit@etik.com</span></span>
        </a>
        <a href="http://github.com/Teksya" target="_blank" rel="noopener" class="flex items-center gap-4 rounded-xl border border-line bg-surface p-4 transition-colors hover:border-line2">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-surface2 text-body"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.33-1.76-1.33-1.76-1.09-.74.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.62-5.48 5.92.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.7.82.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg></span>
          <span><span class="block text-xs text-muted">GitHub</span><span class="block text-sm text-strong">Teksya</span></span>
        </a>
        <a href="https://fr.linkedin.com/in/olivier-dutoit" target="_blank" rel="noopener" class="flex items-center gap-4 rounded-xl border border-line bg-surface p-4 transition-colors hover:border-line2">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-surface2 text-body"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg></span>
          <span><span class="block text-xs text-muted">LinkedIn</span><span class="block text-sm text-strong">olivier-dutoit</span></span>
        </a>
        <div class="flex items-center gap-4 rounded-xl border border-line bg-surface p-4">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-lg bg-surface2 text-body"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <span><span class="block text-xs text-muted">Localisation</span><span class="block text-sm text-strong">Saint-Étienne, France</span></span>
        </div>
      </div>
    </div>

    <!-- FORMULAIRE -->
    <div class="reveal" style="transition-delay:.1s">
      <p class="text-sm font-semibold text-accenth">Envoyer un message</p>

      <% if (success) { %>
        <div class="mt-5 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400"><%= success %></div>
      <% } %>
      <% if (error) { %>
        <div class="mt-5 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400"><%= error %></div>
      <% } %>

      <form action="/contact" method="POST" class="mt-5 flex flex-col gap-4">
        <div class="grid gap-4 sm:grid-cols-2">
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-muted" for="name">Nom</label>
            <input class="rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-strong placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none" type="text" id="name" name="name" placeholder="Jean Dupont" required>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-xs font-medium text-muted" for="email">Email</label>
            <input class="rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-strong placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none" type="email" id="email" name="email" placeholder="jean@example.com" required>
          </div>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-muted" for="subject">Sujet</label>
          <input class="rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-strong placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none" type="text" id="subject" name="subject" placeholder="Demande de dev web">
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="text-xs font-medium text-muted" for="message">Message</label>
          <textarea class="min-h-[140px] resize-y rounded-lg border border-line bg-surface px-3.5 py-2.5 text-sm text-strong placeholder:text-muted/70 transition-colors focus:border-accent focus:outline-none" id="message" name="message" placeholder="Bonjour Olivier, ..." required></textarea>
        </div>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
        <div>
          <button class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accenth" type="submit">Envoyer</button>
        </div>
      </form>
    </div>

  </div>

</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<%- include('partials/footer') %>
