<%- include('partials/header') %>

<div class="mx-auto max-w-content px-6 py-16 sm:py-20">

  <!-- BENTO -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 lg:auto-rows-[minmax(11rem,auto)]">

    <!-- HERO -->
    <section class="reveal flex flex-col justify-between rounded-3xl border border-line bg-surface p-8 sm:col-span-2 lg:row-span-2">
      <div>
        <p class="text-sm font-semibold text-accenth">Étudiant en informatique · France</p>
        <h1 class="mt-5 text-4xl font-semibold leading-[1.05] tracking-tight text-strong sm:text-6xl">Olivier<br>Dutoit</h1>
      </div>
      <div>
        <p class="mt-6 max-w-md text-[15px] leading-relaxed text-body">
          Actuellement en <strong class="font-medium text-strong">1<sup>re</sup> année de BTS SIO SISR</strong> en alternance,
          après un <strong class="font-medium text-strong">Bac Pro CIEL</strong> mention Très Bien. Passionné par l'infrastructure IT.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/work" class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-accenth">Voir mes projets</a>
          <a href="/contact" class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 text-sm font-medium text-body transition-colors hover:border-line2 hover:text-strong">Me contacter</a>
        </div>
      </div>
    </section>

    <!-- CHIFFRES -->
    <section class="reveal flex items-center gap-6 rounded-3xl border border-line bg-surface p-6 sm:col-span-2" style="transition-delay:.05s">
      <div class="flex-1">
        <div class="text-3xl font-semibold tracking-tight text-strong sm:text-4xl" data-count="4">+0</div>
        <div class="mt-1 text-xs text-muted">Années à explorer<br>les techs modernes</div>
      </div>
      <div class="h-14 w-px bg-line"></div>
      <div class="flex-1">
        <div class="text-3xl font-semibold tracking-tight text-strong sm:text-4xl" data-count="<%= projectCount %>">+0</div>
        <div class="mt-1 text-xs text-muted">Projets &amp; réalisations<br>infra &amp; dev</div>
      </div>
    </section>

    <!-- OBJECTIF -->
    <section class="reveal flex flex-col justify-between rounded-3xl border border-line bg-surface p-6" style="transition-delay:.1s">
      <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-accent/10 px-2.5 py-1 text-xs font-medium text-accenth">
        <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>En cours
      </span>
      <div class="mt-4">
        <div class="text-lg font-semibold text-strong">BTS SIO SISR</div>
        <div class="mt-1 text-xs text-muted">1<sup>re</sup> année en alternance - réseaux, systèmes, web</div>
      </div>
    </section>

    <!-- LOCALISATION -->
    <section class="reveal flex flex-col justify-between rounded-3xl border border-line bg-surface p-6" style="transition-delay:.15s">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="text-accenth" aria-hidden="true"><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      <div class="mt-4">
        <div class="text-lg font-semibold text-strong">Saint-Étienne</div>
        <div class="mt-1 text-xs text-muted">France</div>
      </div>
    </section>

    <!-- COMPÉTENCES -->
    <section class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6" style="transition-delay:.05s">
      <h2 class="text-sm font-semibold text-strong">Réseaux &amp; Systèmes</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Windows Server</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Linux</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Cisco</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Mikrotik</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Proxmox</span>
      </div>
    </section>

    <section class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6" style="transition-delay:.1s">
      <h2 class="text-sm font-semibold text-strong">Langages</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">JavaScript</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Node.js</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">PHP</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Python</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">C#</span>
      </div>
    </section>

    <section class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6" style="transition-delay:.15s">
      <h2 class="text-sm font-semibold text-strong">Front-End</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">HTML/CSS</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Tailwind CSS</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Figma</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Canva</span>
      </div>
    </section>

    <section class="reveal flex flex-col rounded-3xl border border-line bg-surface p-6" style="transition-delay:.2s">
      <h2 class="text-sm font-semibold text-strong">Outils &amp; Autres</h2>
      <div class="mt-4 flex flex-wrap gap-2">
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Docker</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Git</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">MySQL</span>
        <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-2.5 py-1 text-xs text-body">Wireshark</span>
      </div>
    </section>

  </div>

</div>

<%- include('partials/footer') %>
