<%- include('partials/header') %>

<div class="mx-auto max-w-content px-6 py-20 sm:py-24">
  <div id="about-config" data-config="<%- encodeURIComponent(JSON.stringify(aboutConfig || {})) %>" hidden></div>

  <!-- INTRO -->
  <section class="reveal rounded-3xl border border-line bg-surface p-8 sm:p-10">
    <p class="text-sm font-semibold text-accenth">À propos</p>
    <h1 class="mt-4 text-4xl font-semibold leading-[1.05] tracking-tight text-strong sm:text-6xl">Olivier<br>Dutoit</h1>
    <p class="mt-6 max-w-xl text-lg text-strong">Construire des infrastructures fiables, automatiser l'ennuyeux, héberger soi-même le reste.</p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-body">
      En <strong class="font-medium text-strong">1<sup>re</sup> année de BTS SIO SISR</strong> (option réseaux &amp; systèmes) en alternance,
      après un Bac Pro CIEL obtenu avec mention Très Bien. Passionné par l'infrastructure et l'administration système,
      je construis des environnements fiables - et je développe aussi mes compétences en web.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-accent/10 px-3 py-1 font-medium text-accenth">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
        En alternance · BTS SIO SISR
      </span>
      <span class="inline-flex items-center gap-1.5 text-muted">
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 4.4-8 12-8 12s-8-7.6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        Saint-Étienne, France
      </span>
    </div>
  </section>

  <!-- WIDGETS LIVE -->
  <section class="reveal mt-8" style="transition-delay:.06s">
    <p class="text-sm font-semibold text-accenth">En direct</p>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">

      <% if (!aboutConfig || aboutConfig.spotifyEnabled) { %>
      <div id="spotify-widget" class="rounded-3xl border border-line bg-surface p-5 sm:col-span-2" style="display:none">
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-2 text-[11px] font-medium text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span><span id="sp-label">Écoute</span>
          </span>
          <svg viewBox="0 0 24 24" fill="#1db954" width="15" height="15" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.516 17.313a.75.75 0 01-1.032.25c-2.822-1.724-6.376-2.114-10.562-1.158a.75.75 0 01-.336-1.462c4.579-1.048 8.504-.597 11.68 1.338a.75.75 0 01.25 1.032zm1.472-3.27a.937.937 0 01-1.288.308c-3.226-1.983-8.148-2.558-11.97-1.4a.938.938 0 01-.544-1.794c4.365-1.324 9.787-.683 13.494 1.597a.938.938 0 01.308 1.289zm.126-3.399c-3.868-2.297-10.246-2.508-13.938-1.387a1.124 1.124 0 01-.651-2.151c4.242-1.287 11.29-1.038 15.746 1.605a1.125 1.125 0 01-1.157 1.933z"/></svg>
        </div>
        <div class="mt-4 flex items-center gap-4">
          <img id="sp-img" class="h-14 w-14 flex-none rounded-lg object-cover" src="" alt="">
          <div class="min-w-0">
            <a id="sp-title" class="block truncate text-sm font-semibold text-strong hover:text-accenth" href="#" target="_blank" rel="noopener"></a>
            <div id="sp-artist" class="truncate text-sm text-muted"></div>
          </div>
        </div>
        <div class="sp-card__progress mt-4">
          <div class="h-1 overflow-hidden rounded-full bg-surface2"><div id="sp-bar" class="h-full rounded-full bg-accent" style="width:0%"></div></div>
          <div class="mt-1.5 flex justify-between text-[11px] tabular-nums text-muted"><span id="sp-current">0:00</span><span id="sp-duration">0:00</span></div>
        </div>
      </div>
      <% } %>

      <% if (!aboutConfig || aboutConfig.discordEnabled) { %>
      <div id="discord-widget" class="rounded-3xl border border-line bg-surface p-5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-medium text-muted">Discord</span>
          <svg viewBox="0 0 24 24" fill="#5865f2" width="15" height="15" aria-hidden="true"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <span class="relative flex-none">
            <img id="dc-avatar" class="h-11 w-11 rounded-full object-cover" src="<%= (aboutConfig && aboutConfig.discordAvatarUrl) ? aboutConfig.discordAvatarUrl : 'https://cdn.discordapp.com/avatars/293855276665405440/c0b1517c692b47673ddcfc35214514f3.webp?size=80' %>" alt="<%= (aboutConfig && aboutConfig.discordUsername) ? aboutConfig.discordUsername : 'Discord' %>">
            <span id="dc-dot" class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-surface" data-status="offline"></span>
          </span>
          <span class="min-w-0">
            <span class="block truncate text-sm font-semibold text-strong"><%= (aboutConfig && aboutConfig.discordUsername) ? aboutConfig.discordUsername : 'Discord' %></span>
            <span id="dc-status" class="block text-sm text-muted">Hors ligne</span>
          </span>
        </div>
        <div id="dc-activity" class="mt-4 border-t border-line pt-4" style="display:none">
          <div id="dc-act-label" class="text-[10px] font-medium uppercase tracking-wide text-muted">En cours</div>
          <div class="mt-2 flex gap-3">
            <div id="dc-act-imgs" class="relative flex-none" style="display:none">
              <img id="dc-act-large" class="h-11 w-11 rounded-lg object-cover" src="" alt="">
              <img id="dc-act-small" class="absolute -bottom-1 -right-1 h-5 w-5 rounded-full border border-surface object-cover" src="" alt="" style="display:none">
            </div>
            <div class="min-w-0">
              <div id="dc-act-name" class="truncate text-sm font-medium text-strong"></div>
              <div id="dc-act-details" class="truncate text-xs text-muted"></div>
              <div id="dc-act-state" class="truncate text-xs text-muted"></div>
            </div>
          </div>
        </div>
      </div>
      <% } %>

      <% if (!aboutConfig || aboutConfig.githubEnabled) { %>
      <div id="gh-card" class="rounded-3xl border border-line bg-surface p-5">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-medium text-muted">GitHub</span>
          <svg viewBox="0 0 24 24" fill="#e6edf3" width="15" height="15" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        </div>
        <div class="mt-4 flex items-center gap-3">
          <img class="h-11 w-11 flex-none rounded-full object-cover" src="https://github.com/<%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'Teksya' %>.png?size=80" alt="<%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'GitHub' %>">
          <span class="min-w-0">
            <span class="block truncate text-sm font-semibold text-strong"><%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'GitHub' %></span>
            <span class="block truncate text-sm text-muted">@<%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'github' %></span>
          </span>
        </div>
        <div id="gh-activity" class="mt-4 border-t border-line pt-4" style="display:none">
          <div class="text-[10px] font-medium uppercase tracking-wide text-muted">Dernier push</div>
          <a id="gh-act-action" class="mt-2 block truncate text-sm font-medium text-strong hover:text-accenth" href="#" target="_blank" rel="noopener"></a>
          <div id="gh-act-repo" class="truncate text-xs text-muted"></div>
          <div id="gh-act-time" class="text-xs text-muted"></div>
        </div>
      </div>
      <% } %>

      <% if (!aboutConfig || aboutConfig.homelabEnabled) { %>
      <a id="ut-card" class="block rounded-3xl border border-line bg-surface p-5 transition-colors hover:border-line2" href="https://status.olivier-dutoit.fr/" style="display:none">
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-2 text-[11px] font-medium text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>Status
          </span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="15" height="15" class="text-muted" aria-hidden="true"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><circle cx="5.5" cy="6.5" r="1" fill="currentColor"/><circle cx="5.5" cy="17.5" r="1" fill="currentColor"/></svg>
        </div>
        <div class="mt-4">
          <span class="block text-sm font-semibold text-strong"><%= (aboutConfig && aboutConfig.homelabName) ? aboutConfig.homelabName : 'Homelab' %></span>
          <span id="ut-status" class="block text-sm text-muted">Chargement...</span>
        </div>
        <div id="ut-groups" class="mt-3 space-y-1.5"></div>
      </a>
      <% } %>

    </div>
  </section>

  <!-- PARCOURS -->
  <section class="reveal mt-8 rounded-3xl border border-line bg-surface p-6 sm:p-8" style="transition-delay:.06s">
    <p class="text-sm font-semibold text-accenth">Parcours</p>
    <ol class="mt-6 space-y-6 border-l border-line pl-6">
      <li class="relative">
        <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-surface bg-accent"></span>
        <span class="text-xs tabular-nums text-muted">Sept. 2026 - 2028</span>
        <h3 class="mt-1 flex flex-wrap items-center gap-2 text-base font-semibold text-strong">BTS SIO SISR <span class="rounded-full bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accenth">1<sup>re</sup> année · alternance</span></h3>
        <p class="mt-1 text-sm text-body">Services Informatiques aux Organisations, option Solutions d'Infrastructure, Systèmes &amp; Réseaux.</p>
      </li>
      <li class="relative">
        <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-surface bg-muted"></span>
        <span class="text-xs tabular-nums text-muted">2023 - 2026</span>
        <h3 class="mt-1 flex flex-wrap items-center gap-2 text-base font-semibold text-strong">Bac Pro CIEL <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-body">Mention Très Bien</span></h3>
        <p class="mt-1 text-sm text-body">Cybersécurité, Informatique &amp; réseaux, Électronique. Bases solides en systèmes, réseaux et infrastructure.</p>
        <button type="button" class="mt-3 inline-flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-xs text-body transition-colors hover:border-line2 hover:text-strong" data-diploma-verify aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M12 3l7 4v5c0 4.4-3 8.4-7 9-4-.6-7-4.6-7-9V7l7-4Z"/></svg>
          Vérifier le diplôme
        </button>
      </li>
      <li class="relative">
        <span class="absolute -left-[27px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-surface bg-muted"></span>
        <span class="text-xs tabular-nums text-muted">2023</span>
        <h3 class="mt-1 flex flex-wrap items-center gap-2 text-base font-semibold text-strong">Diplôme National du Brevet <span class="rounded-full border border-line px-2.5 py-0.5 text-xs text-body">Mention Très Bien</span></h3>
        <p class="mt-1 text-sm text-body">Série professionnelle. Validation des acquis du collège.</p>
      </li>
    </ol>
  </section>

  <!-- DOMAINES -->
  <section class="mt-8">
    <p class="reveal text-sm font-semibold text-accenth">Domaines</p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <div class="reveal rounded-3xl border border-line bg-surface p-6 transition-colors hover:border-line2">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface2 text-accenth">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="2.4"/><circle cx="5" cy="19" r="2.4"/><circle cx="19" cy="19" r="2.4"/><path d="M12 7.4v3.1M10.4 13 6.8 16.8M13.6 13l3.6 3.8"/></svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-strong">Réseaux</h3>
        <p class="mt-1.5 text-sm text-body">Routage, VLAN, pare-feu, VPN. Matériels Mikrotik, HP Aruba, Cisco.</p>
      </div>
      <div class="reveal rounded-3xl border border-line bg-surface p-6 transition-colors hover:border-line2" style="transition-delay:.05s">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface2 text-accenth">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="6" rx="1.5"/><rect x="3" y="14" width="18" height="6" rx="1.5"/><path d="M7 7h.01M7 17h.01"/></svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-strong">Administration système</h3>
        <p class="mt-1.5 text-sm text-body">Linux (Debian, Ubuntu), virtualisation Proxmox, Docker, services (DNS, mail, NAS).</p>
      </div>
      <div class="reveal rounded-3xl border border-line bg-surface p-6 transition-colors hover:border-line2" style="transition-delay:.1s">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface2 text-accenth">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 9-3 3 3 3M16 9l3 3-3 3M13.5 7l-3 10"/></svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-strong">Développement web</h3>
        <p class="mt-1.5 text-sm text-body">Node.js, Express, EJS, APIs REST. Ce site en est un exemple.</p>
      </div>
      <div class="reveal rounded-3xl border border-line bg-surface p-6 transition-colors hover:border-line2" style="transition-delay:.15s">
        <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-surface2 text-accenth">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.7 4.8L18.5 9l-4.8 1.2L12 15l-1.7-4.8L5.5 9l4.8-1.2zM18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></svg>
        </div>
        <h3 class="mt-4 text-base font-semibold text-strong">Centres d'intérêt</h3>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-3 py-1 text-xs text-body">Homelab</span>
          <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-3 py-1 text-xs text-body">Self-hosting</span>
          <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-3 py-1 text-xs text-body">Serveurs de jeu</span>
          <span class="inline-flex items-center rounded-full border border-line bg-surface2 px-3 py-1 text-xs text-body">Veille techno</span>
        </div>
      </div>
    </div>
  </section>

</div>

<!-- MODAL VÉRIFICATION DIPLÔME -->
<div id="diploma-modal" hidden>
  <div class="absolute inset-0 bg-black/60 backdrop-blur-md" data-diploma-close></div>
  <div class="relative z-10 w-full max-w-md rounded-3xl border border-line bg-surface p-8 text-center sm:p-10" role="dialog" aria-modal="true" aria-labelledby="dv-title">
    <button type="button" class="dv-close absolute right-5 top-5 flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface2 hover:text-strong" data-diploma-close aria-label="Fermer">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
    <h2 id="dv-title" class="text-2xl font-semibold tracking-tight text-strong">Bac Pro CIEL</h2>
    <p class="mt-1.5 text-sm text-muted">Authenticité vérifiable &middot; 2026</p>
    <div class="mt-8 inline-flex rounded-3xl bg-white p-5 shadow-xl shadow-black/30">
      <img class="block h-auto w-72 max-w-full" src="/diploma-ciel-qr.svg" width="288" height="288" decoding="async" alt="QR code de vérification d'authenticité du diplôme Bac Pro CIEL">
    </div>
    <p class="mx-auto mt-8 max-w-xs text-sm leading-relaxed text-muted">
      Scannez ce code avec l'application <span class="font-medium text-body">Cyclades Vérif</span> pour vérifier l'authenticité du diplôme.
    </p>
  </div>
</div>

<script src="/js/about.js" defer></script>
<script src="/js/diploma-verify.js" defer></script>

<%- include('partials/footer') %>
