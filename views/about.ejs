<%- include('partials/header') %>

<div class="page-wrap">
  <div id="about-config" data-config="<%- encodeURIComponent(JSON.stringify(aboutConfig || {})) %>" hidden></div>

  <section style="padding:4rem 0 2.5rem">
    <p class="section-label reveal">A propos</p>
    <h1 class="reveal" style="font-size:clamp(2rem,4vw,3rem);font-weight:800;color:var(--text-strong);margin-bottom:.75rem;transition-delay:.05s">Qui suis-je</h1>
    <p class="reveal" style="color:var(--text);max-width:540px;transition-delay:.1s">
      Actuellement en Terminale Bac Pro CIEL, futur alternant en BTS SIO SISR.
      Passionn&eacute; par les r&eacute;seaux et l&apos;administration syst&egrave;me, je construis des infrastructures performantes
      et d&eacute;veloppe &eacute;galement mes comp&eacute;tences en d&eacute;veloppement web.
    </p>

    <div class="status-widgets reveal" style="margin-top:1.5rem;transition-delay:.15s">

    <% if (!aboutConfig || aboutConfig.spotifyEnabled) { %>
    <div id="spotify-widget" class="sp-card" style="display:none">
      <div class="sp-card__banner"></div>
      <div class="sp-card__top">
        <div class="sp-card__cover-wrap">
          <img id="sp-img" class="sp-card__cover" src="" alt="">
          <div class="sp-card__bars" aria-hidden="true"><span></span><span></span><span></span></div>
        </div>
        <svg class="sp-card__logo" viewBox="0 0 24 24" fill="#1db954" width="18" height="18"><path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.516 17.313a.75.75 0 01-1.032.25c-2.822-1.724-6.376-2.114-10.562-1.158a.75.75 0 01-.336-1.462c4.579-1.048 8.504-.597 11.68 1.338a.75.75 0 01.25 1.032zm1.472-3.27a.937.937 0 01-1.288.308c-3.226-1.983-8.148-2.558-11.97-1.4a.938.938 0 01-.544-1.794c4.365-1.324 9.787-.683 13.494 1.597a.938.938 0 01.308 1.289zm.126-3.399c-3.868-2.297-10.246-2.508-13.938-1.387a1.124 1.124 0 01-.651-2.151c4.242-1.287 11.29-1.038 15.746 1.605a1.125 1.125 0 01-1.157 1.933z"/></svg>
      </div>
      <div class="sp-card__body">
        <div class="sp-card__act-row">
          <div class="sp-card__act-info">
            <div id="sp-label" class="sp-card__label">ÉCOUTE</div>
            <a id="sp-title" class="sp-card__title" href="#" target="_blank" rel="noopener"></a>
            <div id="sp-artist" class="sp-card__artist"></div>
            <div id="sp-last-time" class="sp-card__last-time" style="display:none"></div>
          </div>
        </div>
          <div class="card__divider"></div>
        <div class="sp-card__progress">
          <div class="sp-card__progress-times">
            <span id="sp-current">0:00</span>
            <span id="sp-duration">0:00</span>
          </div>
          <div class="sp-card__progress-bar">
            <div id="sp-bar" class="sp-card__progress-fill"></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (!aboutConfig || aboutConfig.discordEnabled) { %>
    <div id="discord-widget" class="dc-card">
      <div class="dc-card__banner"></div>
      <div class="dc-card__top">
        <div class="dc-card__avatar-wrap">
          <img id="dc-avatar" class="dc-card__avatar" src="<%= (aboutConfig && aboutConfig.discordAvatarUrl) ? aboutConfig.discordAvatarUrl : 'https://cdn.discordapp.com/avatars/293855276665405440/c0b1517c692b47673ddcfc35214514f3.webp?size=80' %>" alt="<%= (aboutConfig && aboutConfig.discordUsername) ? aboutConfig.discordUsername : 'Discord' %>">
          <span id="dc-dot" class="dc-card__dot" data-status="offline"></span>
        </div>
        <svg class="dc-card__logo" viewBox="0 0 24 24" fill="#5865f2" width="18" height="18"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
      </div>
      <div class="dc-card__body">
        <div class="dc-card__name"><%= (aboutConfig && aboutConfig.discordUsername) ? aboutConfig.discordUsername : 'Discord' %></div>
        <div id="dc-status" class="dc-card__status">Hors ligne</div>
      </div>
      <div id="dc-activity" class="dc-card__activity" style="display:none">
        <div class="card__divider"></div>
        <div id="dc-act-label" class="dc-card__act-label">EN COURS</div>
        <div class="dc-card__act-row">
          <div class="dc-card__act-imgs" id="dc-act-imgs" style="display:none">
            <img id="dc-act-large" class="dc-card__act-large" src="" alt="">
            <img id="dc-act-small" class="dc-card__act-small" src="" alt="" style="display:none">
          </div>
          <div class="dc-card__act-info">
            <div id="dc-act-name" class="dc-card__act-name"></div>
            <div id="dc-act-details" class="dc-card__act-details"></div>
            <div id="dc-act-state" class="dc-card__act-state"></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (!aboutConfig || aboutConfig.githubEnabled) { %>
    <div id="gh-card" class="gh-card">
      <div class="gh-card__banner"></div>
      <div class="gh-card__top">
        <div class="gh-card__avatar-wrap">
          <img class="gh-card__avatar" src="https://github.com/<%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'Teksya' %>.png?size=80" alt="<%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'GitHub' %>">
        </div>
        <svg class="gh-card__logo" viewBox="0 0 24 24" fill="#e6edf3" width="18" height="18"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
      </div>
      <div class="gh-card__body">
        <div class="gh-card__name"><%= (aboutConfig && aboutConfig.githubUsername) ? aboutConfig.githubUsername : 'GitHub' %></div>
        <div class="gh-card__sub">GitHub</div>
      </div>
      <div id="gh-activity" class="gh-card__activity" style="display:none">
        <div class="card__divider"></div>
        <div class="gh-card__act-label">DERNI&Egrave;RE ACTIVIT&Eacute;</div>
        <div class="gh-card__act-row">
          <div class="gh-card__act-info">
            <a id="gh-act-action" class="gh-card__act-name" href="#" target="_blank" rel="noopener"></a>
            <div id="gh-act-repo" class="gh-card__act-details"></div>
            <div id="gh-act-time" class="gh-card__act-time"></div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (!aboutConfig || aboutConfig.homelabEnabled) { %>
    <a id="ut-card" class="ut-card ut-card--link" href="https://status.olivierd.fr/" style="display:none">
      <div class="ut-card__banner"></div>
      <div class="ut-card__top">
        <div class="ut-card__icon-wrap">
          <svg class="ut-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="28" height="28"><rect x="2" y="3" width="20" height="7" rx="1.5"/><rect x="2" y="14" width="20" height="7" rx="1.5"/><circle cx="5.5" cy="6.5" r="1" fill="currentColor"/><circle cx="5.5" cy="17.5" r="1" fill="currentColor"/></svg>
        </div>
<img src="https://status.olivierd.fr/badge/_/uptime?sinceLast=2592000&color=043724&style=flat-square" alt="uptime" style="max-width: 150px;" />      </div>
      <div class="ut-card__body">
        <div class="ut-card__name"><%= (aboutConfig && aboutConfig.homelabName) ? aboutConfig.homelabName : 'Homelab' %></div> 
        <div id="ut-status" class="ut-card__status">Chargement...</div> 
      </div>
      <div class="card__divider"></div>
      <div id="ut-groups" class="ut-card__groups"></div>
    </a>
    <% } %>

    </div>
  </section>

  <section style="padding-bottom:3rem">
    <p class="section-label reveal" style="margin-bottom:1.25rem">Domaines</p>
    <div class="reveal" style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;transition-delay:.05s">

      <div class="card">
        <div class="card-body">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem">
            <div style="width:36px;height:36px;border-radius:8px;background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fa-solid fa-network-wired" style="color:var(--accent);font-size:.9rem"></i>
            </div>
            <div class="card-title" style="margin:0">R&eacute;seaux</div>
          </div>
          <p class="card-desc">Configuration d&apos;infrastructures r&eacute;seau, routage, VLAN, pare-feu, VPN. Mat&eacute;riels Mikrotik, HP Aruba, Cisco.</p>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <div style="display:flex;align-items:center;gap:.75rem;margin-bottom:1rem">
            <div style="width:36px;height:36px;border-radius:8px;background:var(--accent-dim);display:flex;align-items:center;justify-content:center;flex-shrink:0">
              <i class="fa-solid fa-server" style="color:var(--accent);font-size:.9rem"></i>
            </div>
            <div class="card-title" style="margin:0">Administration Syst&egrave;me</div>
          </div>
          <p class="card-desc">Linux (Debian, Ubuntu), virtualisation Proxmox, Docker, gestion de services (DHCP, DNS, mail, NAS).</p>
        </div>
      </div>

    </div>
  </section>

  <section style="padding-bottom:5rem">
    <p class="section-label reveal" style="margin-bottom:1.25rem">Technologies</p>

    <div class="tech-card-grid reveal" style="display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;transition-delay:.07s">

      <div class="tech-card">
        <div class="tech-card__title">R&eacute;seaux &amp; Syst&egrave;mes</div>
        <div class="tech-card__chips">
          <span class="chip">Windows Server</span>
          <span class="chip">Linux</span>
          <span class="chip">Cisco</span>
          <span class="chip">Mikrotik</span>
          <span class="chip">Wireshark</span>
        </div>
      </div>

      <div class="tech-card">
        <div class="tech-card__title">Langages</div>
        <div class="tech-card__chips">
          <span class="chip">JavaScript</span>
          <span class="chip">Node.js</span>
          <span class="chip">PHP</span>
          <span class="chip">Python</span>
          <span class="chip">C#</span>
          <span class="chip">Java</span>
          <span class="chip">Lua</span>
        </div>
      </div>

      <div class="tech-card">
        <div class="tech-card__title">Front-End</div>
        <div class="tech-card__chips">
          <span class="chip">HTML/CSS</span>
          <span class="chip">Tailwind CSS</span>
          <span class="chip">Figma</span>
          <span class="chip">Canva</span>
        </div>
      </div>

      <div class="tech-card">
        <div class="tech-card__title">Outils &amp; Autres</div>
        <div class="tech-card__chips">
          <span class="chip">Docker</span>
          <span class="chip">Git</span>
          <span class="chip">MySQL</span>
          <span class="chip">Excel</span>
        </div>
      </div>

    </div>
  </section>

</div>

<script src="/js/about.js" defer></script>

<%- include('partials/footer') %>