<%- include('partials/header') %>

<div class="page-wrap">

  <section class="section-header">
    <p class="section-label reveal">Projets &amp; réalisations</p>
    <h1 class="section-title reveal" style="transition-delay:.05s">Mes Travaux</h1>
    <p class="section-desc reveal" style="transition-delay:.1s">Projets académiques et personnels &mdash; infrastructure, administration système, développement.</p>
  </section>

  <section style="padding-bottom:5rem">

    <% const featured = projects.find(p => p.featured); %>
    <% const others = projects.filter(p => !p.featured); %>

    <% if (featured) { %>
      <div class="featured-card reveal card project-card" style="cursor:pointer"
        role="button" tabindex="0" aria-label="Ouvrir le projet : <%= featured.title %>"
        data-title="<%= featured.title %>"
        data-desc="<%= featured.description %>"
        data-image="<%= featured.image %>"
        data-tags="<%= (featured.tags || []).join('|||') %>"
        data-chips="<%= (featured.chips || []).join('|||') %>">
        <img loading="lazy" src="<%= featured.image %>" alt="<%= featured.title %>" class="card-img">
        <div class="card-body">
          <div>
            <div class="featured-chips">
              <% featured.chips.forEach(chip => { %>
                <span class="chip"><%= chip %></span>
              <% }); %>
            </div>
            <div class="featured-title"><%= featured.title %></div>
            <p class="card-desc"><%= featured.description %></p>
          </div>
          <div class="card-tags">
            <% featured.tags.forEach(tag => { %>
              <span class="chip"><%= tag %></span>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>

    <div class="projects-grid">
      <% others.forEach((project, i) => { %>
        <div class="card project-card reveal" style="cursor:pointer;transition-delay:<%= Math.min(i * 0.04, 0.3) %>s"
          role="button" tabindex="0" aria-label="Ouvrir le projet : <%= project.title %>"
          data-title="<%= project.title %>"
          data-desc="<%= project.description %>"
          data-image="<%= project.image %>"
          data-tags="<%= (project.tags || []).join('|||') %>"
          data-chips="<%= (project.chips || []).join('|||') %>">
          <img loading="lazy" src="<%= project.image %>" alt="<%= project.title %>" class="card-img-sm">
          <div class="card-body">
            <div class="card-title"><%= project.title %></div>
            <p class="card-desc"><%= project.description %></p>
            <div class="card-tags">
              <% project.tags.forEach(tag => { %>
                <span class="chip"><%= tag %></span>
              <% }); %>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

  </section>

</div>

<!-- PROJECT MODAL -->
<div class="project-modal" id="project-modal">
  <div class="project-modal__backdrop" id="modal-backdrop"></div>
  <div class="project-modal__content">
    <button class="project-modal__close" id="modal-close">&times;</button>
    <img class="project-modal__img" id="modal-img" src="" alt="">
    <div class="project-modal__body">
      <div class="project-modal__chips" id="modal-chips"></div>
      <h2 class="project-modal__title" id="modal-title"></h2>
      <p class="project-modal__desc" id="modal-desc"></p>
      <div class="project-modal__tags" id="modal-tags"></div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
