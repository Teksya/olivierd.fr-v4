# Copy to .env and fill with your keys from Cloudflare Turnstile
# Get keys from https://dash.cloudflare.com > Security > Bots > Turnstile

CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key_here
 
# SMTP config for sending emails (optional but recommended)
SMTP_HOST=smtp.mail.olivierd.fr
SMTP_PORT=587
SMTP_USER=no-reply@olivierd.fr
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=no-reply@olivierd.fr
TO_EMAIL=contact@olivierd.fr
