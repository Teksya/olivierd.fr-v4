# Copy to .env and fill with your keys from Cloudflare Turnstile
# Get keys from https://dash.cloudflare.com > Security > Bots > Turnstile

CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key_here
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key_here

# Admin access (required for /admin)
ADMIN_ACCESS_CODE=123456
ADMIN_SESSION_SECRET=change_me_with_a_long_random_secret

# Spotify (optional)
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
 
# SMTP config for sending emails (optional but recommended)
SMTP_HOST=smtp.mail.olivier-dutoit.fr
SMTP_PORT=587
SMTP_USER=no-reply@olivier-dutoit.fr
SMTP_PASS=your_smtp_password_here
FROM_EMAIL=no-reply@olivier-dutoit.fr
TO_EMAIL=olivierdutoit@etik.com
